{
	"$schema": "https://json.schemastore.org/electron-builder.json",
	"appId": "ocs.enncy.cn",
	"extraMetadata": {
		"name": "OCS Desktop",
		"description": "OCS 浏览器自动化神器，一键浏览器多开，用户脚本环境一键配置。"
	},
	"productName": "OCS Desktop",
	"asar": false,
	"directories": {
		"output": "../../releases"
	},
	"compression": "maximum",
	"copyright": "Copyright © 2021 ${author}",
	"files": [
		"out/**/*",
		"public/favicon.png",
		"public/favicon.icns",
		"public/favicon.ico",
		"public/icons/**/*",
		"package.json",
		"node_modules/**/*",
		"!**/*.map",
		"!node_modules/xlsx/dist/{shim.min,xlsx.core.min,xlsx.extendscript,xlsx.full.min,xlsx,xlsx.min,xlsx.mini.min}.js"
	],
	"nsis": {
		"oneClick": true
	},
	"electronLanguages": [
		"en-US",
		"en-GB",
		"zh-CN"
	],
	"publish": {
		"provider": "generic",
		"url": "https://cdn.ocsjs.com/app/electron-updater/"
	},
	"win": {
		"icon": "public/favicon.png",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "nsis"
			}
		]
	},
	"mac": {
		"icon": "public/favicon.icns",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "dmg"
			}
		]
	},
	"linux": {
		"icon": "public/icons/512.png",
		"executableName": "ocs-desktop",
		"syncDesktopName": true,
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "AppImage"
			},
			{
				"target": "deb"
			}
		]
	},
	"deb": {
		"depends": [
			"libgtk-3-0",
			"libnotify4",
			"libnss3",
			"libxss1",
			"libxtst6",
			"xdg-utils",
			"libatspi2.0-0",
			"libuuid1",
			"libsecret-1-0",
			"libgbm1",
			"libxkbcommon0",
			"libasound2",
			"gnome-keyring"
		],
		"recommends": [
			"kwallet6"
		]
	}
}